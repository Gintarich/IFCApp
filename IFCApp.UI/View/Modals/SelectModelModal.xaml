<UserControl x:Class="IFCApp.UI.View.Modals.SelectModelModal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:IFCApp.UI.View.Modals"
             mc:Ignorable="d" 
             d:DesignHeight="200" d:DesignWidth="400">
    <Grid Background="White" Width="200">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <ListView ItemsSource="{Binding Models}" Margin="10" Grid.Row="0" SelectedItem="{Binding SelectedItem}"> </ListView>
        <Button Content="Open Model" Grid.Row="1" Command="{Binding OpenModel}" Style="{StaticResource HorPanelButton}"/>
    </Grid>
</UserControl>
