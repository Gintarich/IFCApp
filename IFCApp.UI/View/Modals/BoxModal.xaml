<UserControl x:Class="IFCApp.UI.View.Modals.BoxModal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:IFCApp.UI.View.Modals" 
             xmlns:viewModels="clr-namespace:IFCApp.UI.ViewModel.Modals"
             mc:Ignorable="d" 
             d:DesignHeight="300" d:DesignWidth="600">

    <!--<UserControl.DataContext>
        <viewModels:BoxModalVM/>
    </UserControl.DataContext>-->
    <Grid Background="White" Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <ItemsControl ItemsSource="{Binding BoxItems}" Grid.Row="0">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border BorderBrush="Gray" BorderThickness="1" Padding="5" Margin="2">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Name}" HorizontalAlignment="Center" VerticalAlignment="Center" Width="100" />
                            <TextBlock Text="{Binding MinPt}" HorizontalAlignment="Center" VerticalAlignment="Center" Width="150" Margin="10,0,0,0"/>
                            <TextBlock Text="{Binding MaxPt}" HorizontalAlignment="Center" VerticalAlignment="Center" Width="150" Margin="10,0,0,0"/>
                            <Button  
                                Command="{Binding ShowBoxCommand}" 
                                Style="{StaticResource HorPanelButton}"
                                Content="Show" 
                                Width="50" Margin="10,0,0,0"/>
                            <Button  
                                Command="{Binding DataContext.RemoveItemCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" 
                                Content="&#x2716;" 
                                Foreground="DarkRed"
                                CommandParameter="{Binding}" 
                                Width="30" Margin="10,0,0,0"/>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
        <StackPanel Orientation="Horizontal" Grid.Row="1" Height="50">

            <TextBox 
                Grid.Row="1"
                Margin="10"
                Width="150"
                Text="{Binding BoxName}"
                VerticalContentAlignment="Center"
                Padding="5 0"/>
            <Button 
                Grid.Row="1" 
                Grid.Column="1"
                HorizontalAlignment="Left" 
                Margin="10" 
                Content="Create" 
                Command="{Binding AddBoxCommand}"
                Style="{StaticResource HorPanelButton}"/>
            <Button 
                Grid.Row="1" 
                Grid.Column="2"
                HorizontalAlignment="Left" 
                Margin="10" 
                Content="Close" 
                Command="{Binding CloseModalCommand}"
                Style="{StaticResource HorPanelButton}"/>
        </StackPanel>
    </Grid>
</UserControl>
