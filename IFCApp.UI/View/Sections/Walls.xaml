<UserControl x:Class="IFCApp.UI.View.Sections.Walls"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:IFCApp.UI.View.Sections"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid Background="{StaticResource White}">
        <Button Style="{StaticResource HorPanelButton}"
                Height="30"
                Content="Load Walls"
                Command="{Binding LoadWallsCommand}"/>
    </Grid>
</UserControl>
