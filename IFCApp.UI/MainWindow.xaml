<Window x:Class="IFCApp.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:IFCApp.UI"
        xmlns:viewModels="clr-namespace:IFCApp.UI.ViewModel" 
        xmlns:custom="clr-namespace:ModalControl;assembly=ModalControl"
        mc:Ignorable="d"
        Title="MainWindow" Height="600" Width="900"
        Style="{StaticResource WinAll}">

    <Window.DataContext>
        <viewModels:MainViewModel/>
    </Window.DataContext>
    <Grid>
        <!--<custom:Modal x:Name="modal" Panel.ZIndex="10">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Width="200" Height="200">
                <Button 
                    x:Name="btnCloseModal"
                    Margin="0 10 0 0"
                    Padding="10 5"
                    Click="OnCloseModalClick"
                    Content="Close Modal"/>
            </StackPanel>
        </custom:Modal>-->
        <DockPanel>
            <Grid DockPanel.Dock="Top" Height="45" Background="{StaticResource Grey}">
                <StackPanel Orientation="Horizontal">
                    <Button Content="Parameters" 
                        Style="{StaticResource HorPanelButton}" 
                        />
                    <!--Te vajag ievietot Command="{Binding ChangeToParamsViewCommand}"-->
                    <Button Content="Application 2" 
                        Style="{StaticResource HorPanelButton}"
                        />
                    <!--Te vajag ievietot Command="{Binding ChangeToParamsViewCommand}"-->
                    <Button Content="Application 3" 
                        Style="{StaticResource HorPanelButton}"
                        />
                    <!--Te vajag ievietot Command="{Binding ChangeToParamsViewCommand}"-->
                </StackPanel>
            </Grid>

            <Grid DockPanel.Dock="Bottom">
                <custom:Modal x:Name="modal" Panel.ZIndex="100" IsOpen="{Binding IsOpen}">
                    <ContentControl Content="{Binding SelectedModal}"/>
                    <custom:Modal.Background>
                        <SolidColorBrush Opacity="0.5" Color="Black"/>
                    </custom:Modal.Background>
                </custom:Modal>
                <ContentControl Content="{Binding SelectedViewModel}"/>
            </Grid>

        </DockPanel>
    </Grid>
</Window>
